FROM nvidia/cuda:12.4.1-cudnn-runtime-ubuntu22.04

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1

RUN apt-get update && apt-get install -y --no-install-recommends \
    python3 python3-pip libglib2.0-0 libgl1 ca-certificates \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY requirements-gpu.txt /app/requirements-gpu.txt
RUN python3 -m pip install --upgrade pip setuptools wheel \
    && python3 -m pip install -r /app/requirements-gpu.txt \
    && python3 -m pip install onnxruntime-gpu grpcio rtmlib "skellytracker[all-cuda]"

COPY gpu_server /app/gpu_server
COPY inference/python /app/inference/python
RUN mkdir -p /app/calibration /models

EXPOSE 50052
CMD ["python3", "-m", "inference.python.worker", "--listen", "0.0.0.0:50052"]
