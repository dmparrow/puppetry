FROM nvidia/cuda:12.4.1-cudnn-runtime-ubuntu22.04

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1

RUN apt-get update && apt-get install -y --no-install-recommends \
    python3 \
    python3-venv \
    python3-pip \
    libglib2.0-0 \
    libgl1 \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY requirements-gpu.txt /app/requirements-gpu.txt
RUN python3 -m pip install --upgrade pip setuptools wheel \
    && python3 -m pip install -r /app/requirements-gpu.txt \
    && python3 -m pip install "skellytracker[all-cuda]" rtmlib

COPY gpu_server /app/gpu_server
COPY config.example.yaml /app/config.example.yaml

RUN mkdir -p /app/calibration

EXPOSE 8765 8766

CMD ["python3", "-m", "gpu_server.main", "--config", "/app/config.yaml"]
