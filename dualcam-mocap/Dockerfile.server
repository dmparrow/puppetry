FROM golang:1.23-bookworm AS build
WORKDIR /src
COPY go.mod ./
RUN go mod download
COPY internal ./internal
COPY cmd/server ./cmd/server
RUN CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /out/mocap-server ./cmd/server

FROM gcr.io/distroless/static-debian12:nonroot
COPY --from=build /out/mocap-server /mocap-server
EXPOSE 50051 8766
ENTRYPOINT ["/mocap-server"]
CMD ["--grpc=:50051", "--worker=inference:50052", "--blender=:8766"]
